#!/bin/sh
set -eu

resolve_self() {
  target="$0"
  while [ -L "$target" ]; do
    link="$(readlink "$target")"
    case "$link" in
      /*) target="$link" ;;
      *) target="$(dirname "$target")/$link" ;;
    esac
  done
  (cd "$(dirname "$target")" && pwd -P)
}

BIN_DIR="$(resolve_self)"
ROOT_DIR="$(cd "$BIN_DIR/.." && pwd -P)"

subcommand="${1:-}"
[ $# -gt 0 ] && shift

case "$subcommand" in
  init)
    exec bash "$ROOT_DIR/init.sh" "$@"
    ;;
  check)
    exec python3 "$ROOT_DIR/comment_intent_guard.py" "$@"
    ;;
  scan)
    exec python3 "$ROOT_DIR/comment_intent_guard.py" --scan "$@"
    ;;
  *)
    echo "usage: comment-intent-guard <init|check|scan> [args...]" >&2
    exit 2
    ;;
esac
